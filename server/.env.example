# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection
# Use a local MongoDB URI or MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/mailpilot

# JWT Authentication
# Replace with a strong random secret (at least 32 characters)
JWT_SECRET=replace-with-a-strong-random-jwt-secret-key
JWT_EXPIRES_IN=7d

# Google Gemini API (Backend only - never expose in frontend)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# Google OAuth 2.0 for Gmail & Google Calendar APIs
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/google/callback

# Supabase Postgres Sync (Backend only - keep secret/service_role key private)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SECRET_KEY=sb_secret_your_key


